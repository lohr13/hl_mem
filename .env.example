# === LLM 提取 — 百炼 Coding Plan ===
# Coding Plan AK 只能打 coding.dashscope 端点
# [stable]
LLM_API_KEY=sk-sp-xxx
# [stable]
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_MODEL=glm-5.2
LLM_TIMEOUT=30
LLM_MAX_ATTEMPTS=3
HL_MEM_LLM_PROVIDER=dashscope        # dashscope | zhipu | openai_compatible
HL_MEM_LLM_STRUCTURED_MODE=json_object
HL_MEM_LLM_SCHEMA_RETRIES=2
# 可选布尔值；留空时不向 provider 发送 enable_thinking
# HL_MEM_LLM_ENABLE_THINKING=false

# === Embedding — 百炼通用 AK ===
# 通用 AK 只能打 compatible-mode 端点，与 Coding Plan AK 互不通用
# [stable]
EMBEDDING_API_KEY=sk-e72xxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# [stable]
EMBEDDING_DIM=2048
EMBEDDING_CONNECT_TIMEOUT=5
EMBEDDING_READ_TIMEOUT=30
EMBEDDING_MAX_ATTEMPTS=3

# === Reranker — 百炼通用 AK（可选，off 则跳过）===
# [beta]
HL_MEM_RERANKER=on
RERANKER_API_KEY=sk-e72xxx
RERANKER_BASE_URL=https://dashscope.aliyuncs.com
RERANKER_MODEL=gte-rerank-v2

# === 运行模式 ===
# [stable]
HL_MEM_ENV=dev                    # dev | production（production 强制 real embedder + reranker）
# [stable]
HL_MEM_DB_PATH=var/hl_mem.db
HL_MEM_EXTRACTOR=llm              # fake | llm（测试用 fake）
HL_MEM_EMBEDDER=real              # fake | real（测试用 fake）
HL_MEM_INDEX_TEXT_MODE=legacy     # legacy | value_only | natural

# === 结构化提取分块 / repair ===
HL_MEM_EXTRACTION_CHUNK_TARGET_CHARS=12000
HL_MEM_EXTRACTION_CHUNK_OVERLAP_TURNS=2
HL_MEM_EXTRACTION_MAX_SPLIT_DEPTH=3

# === 去重 / 冲突阈值 ===
HL_MEM_DEDUP_THRESHOLD=0.82

# === Worker ===
HL_MEM_WORKER_POLL_INTERVAL=2.0
HL_MEM_WORKER_LEASE_MINUTES=5
HL_MEM_WORKER_MAINTENANCE_INTERVAL=600

# === 召回 ===
HL_MEM_RECALL_DEFAULT_LIMIT=20
HL_MEM_RECALL_VECTOR_SCAN_LIMIT=200

# === 多查询召回 ===
# auto 仅在短查询或指代查询时调用 LLM 扩展；超时或失败自动回退原始 query
# [beta]
HL_MEM_QUERY_EXPANSION_MODE=auto              # off | auto | always
HL_MEM_QUERY_EXPANSION_MAX=2                 # 每次最多生成 2 个扩展查询
HL_MEM_QUERY_EXPANSION_CANDIDATE_FLOOR=8     # 候选不足时允许 auto 触发
HL_MEM_QUERY_EXPANSION_TOKEN_CEILING=256     # 单次扩展 token 上限
HL_MEM_QUERY_EXPANSION_TIMEOUT_SECONDS=2.0
HL_MEM_QUERY_EXPANSION_TOTAL_TIMEOUT_SECONDS=3.0

# === 关系候选发现 ===
# audit 只写 proposal，不自动写关系边；评估准确率后可切换 auto
# [beta]
HL_MEM_RELATION_DISCOVERY_MODE=audit          # off | audit | auto
HL_MEM_RELATION_DISCOVERY_POOL_LIMIT=40
HL_MEM_RELATION_DISCOVERY_MAX_PROPOSALS=10
HL_MEM_RELATION_AUTO_APPLY_CONFIDENCE=0.90
HL_MEM_RELATION_CONFLICT_CONFIDENCE=0.80

# === 图片证据入口 ===
# 当前没有图片输入源，默认关闭；接入视觉 API 后改为 on
# [experimental]
HL_MEM_IMAGE_DESCRIBER_MODE=off               # off | on
HL_MEM_IMAGE_DESCRIBER_PROVIDER=dashscope
# IMAGE_API_KEY=sk-sp-xxx                      # 未设置时回退 LLM_API_KEY
HL_MEM_IMAGE_DESCRIBER_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
HL_MEM_IMAGE_DESCRIBER_MODEL=qwen3.7-plus
HL_MEM_IMAGE_DESCRIBER_TIMEOUT_SECONDS=20
HL_MEM_IMAGE_MAX_BYTES=10485760
HL_MEM_IMAGE_MAX_PARTS=4
HL_MEM_IMAGE_ALLOW_FILE_URIS=false            # 启用时必须同时配置允许目录
# HL_MEM_IMAGE_FILE_ALLOW_ROOTS=D:\images

# === 实验性检索与提取通道 ===
# [experimental]
HL_MEM_EXTRACT_PRE_FILTER=off                  # off | on
# [experimental]
HL_MEM_TAG_CHANNEL_ENABLED=false

# === 反馈驱动维护 ===
# observe 只聚合 usefulness，不改变 TTL/decay；观察稳定后可改为 on
HL_MEM_FEEDBACK_LIFECYCLE_MODE=observe         # off | observe | on
HL_MEM_FEEDBACK_BONUS_EVERY=3
HL_MEM_FEEDBACK_BONUS_DAYS=14
HL_MEM_FEEDBACK_BONUS_CAP_DAYS=180
HL_MEM_FEEDBACK_MIN_SAMPLES=3

# === Tool / Procedure intent ===
# keyword 为零 LLM 调用的确定性路由，仅 TOOL/PROCEDURE intent 进入 Experience pipeline
HL_MEM_PROCEDURE_RECALL_MODE=keyword           # off | keyword | auto
HL_MEM_PROCEDURE_LLM_THRESHOLD=0.80
HL_MEM_PROCEDURE_ROUTER_TIMEOUT_SECONDS=1.5
HL_MEM_PROCEDURE_CANDIDATE_LIMIT=30
HL_MEM_PROCEDURE_RECENT_OUTCOME_WINDOW=20
HL_MEM_PROCEDURE_OUTCOME_HALF_LIFE_DAYS=30

# Benchmark suite 无常驻配置，通过 CLI 按需运行。

# === 数据保留 ===
HL_MEM_RETENTION_DAYS=30
HL_MEM_STATE_TRANSIENT_TTL_DAYS=7
HL_MEM_STATE_TEST_SUITE_TTL_DAYS=7

# === Token 预算 ===
HL_MEM_DAILY_TOKEN_LIMIT=10000000000
